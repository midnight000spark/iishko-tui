{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023"], "module": "ESNext",
    "moduleResolution": "bundler", "types": ["node", "bun"],
    "strict": true, "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true,
    "jsx": "preserve", "jsxImportSource": "@opentui/solid", "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "tui.ts"]
}
